# Local certificates
certs/*.pem
certs/*.key
certs/*.crt

# Logs and editor artifacts
backend/logs/*
!backend/logs/.gitkeep
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.tmp
*.temp
.cache/
.eslintcache
