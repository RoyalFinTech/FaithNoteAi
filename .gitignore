# Dependencies
node_modules/

# Backend secrets
backend/.env
.env
!.env.example

# SQLite runtime files
backend/database/*.sqlite
backend/database/*.sqlite-shm
backend/database/*.sqlite-wal
backend/test/*.sqlite
backend/test/*.sqlite-shm
backend/test/*.sqlite-wal

# User-uploaded runtime data
backend/uploads/*
